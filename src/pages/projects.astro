---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects Header</div>
  </div>

  <HorizontalCard
    title="Ad Click-Through Recommendation Engine"
    img="/recsys_ctr.webp"
    desc="A recommendation engine that selects which product ad to send each user on a messaging platform. Four candidate approaches — popularity, demographic popularity, item-item collaborative filtering, and a gradient-boosted click-through model — were compared head-to-head, with model selection driven by validation metrics rather than assumption. Ranking quality improved from 0.57 to 0.88 AUC across the candidates; the selected model achieved 0.86 on a held-out test set, correctly ranking a clicked ad above an ignored one 86% of the time. Recall@10 reached 0.027 against an estimated theoretical ceiling of 0.03–0.05. The system handles previously unseen users and items, and trains end to end in under a minute."
    url="https://github.com/nitinmittal526/ctr-recommendation-engine"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Predictive Modeling and Demand Forecasting for AC Servicing Business"
    img="/ac_dp.webp"
    desc="Explored how marketing spend and weather influenced AC service orders, and developed a forecasting model to predict demand for the second half of May 2025."
    url="https://github.com/nitinmittal526/ac_servicing"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
  title="E-Bawarchi - Business Environment Analysis"
  img="/e_bawarchi.webp"
  desc="Led business research for an automated kitchen robotics venture as part of the Essentials of Entrepreneurship course. Conducted market research, user surveys, SWOT and PESTEL analyses to assess viability. Designed app wireframes for remote control and contributed to go-to-market and manufacturing strategy planning."
  url="https://drive.google.com/file/d/1fAE2aXCb0KV8OvMPrrM7yRSOpkJgq04l/view"
/>


 

  <div class="divider my-0"></div>

</BaseLayout>
